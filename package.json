{
  "name": "flightmapper-front",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@primer/octicons-react": "^19.40.0",
    "@react-icons/all-files": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "d3": "^7.9.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "^5.0.1",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(d3|d3-[^/]+|internmap|delaunator|robust-predicates|uqr)/)"
    ],
    "moduleNameMapper": {
      "^@ark-ui/react/(anatomy|factory)$": "<rootDir>/node_modules/@ark-ui/react/dist/components/$1.cjs",
      "^@ark-ui/react/(environment|locale)$": "<rootDir>/node_modules/@ark-ui/react/dist/providers/$1/index.cjs",
      "^@ark-ui/react/utils$": "<rootDir>/node_modules/@ark-ui/react/dist/utils/index.cjs",
      "^@ark-ui/react/(.*)$": "<rootDir>/node_modules/@ark-ui/react/dist/components/$1/index.cjs"
    }
  }
}
